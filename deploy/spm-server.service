[Unit]
Description=SPM monitoring server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=spm
Group=spm
StateDirectory=spm
StateDirectoryMode=0700
WorkingDirectory=/var/lib/spm
EnvironmentFile=/etc/spm/server.env
ExecStart=/opt/spm/spm-server
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
