SPM_ADMIN_USER=admin
SPM_ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_RANDOM_PASSWORD
SPM_LISTEN=127.0.0.1:8080
SPM_DATA_DIR=/var/lib/spm
